{
  "name": "@bootstrap-framework/redis",
  "version": "1.0.0",
  "description": "Production-ready Redis client and BullMQ queue utilities for Node.js. Works standalone or with any framework logger.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js",
      "default": "./dist/queue/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "lint": "eslint src test",
    "example:standalone": "node examples/standalone.js",
    "example:cache": "node examples/cache.js",
    "example:session": "node examples/session.js",
    "example:pubsub": "node examples/pubsub.js",
    "example:queue-worker": "node examples/queue-worker.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "redis",
    "ioredis",
    "bullmq",
    "queue",
    "worker",
    "cache",
    "session",
    "nodejs",
    "microservice",
    "bootstrap-framework"
  ],
  "author": "mayank",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank040902/framework.git",
    "directory": "packages/redis"
  },
  "bugs": {
    "url": "https://github.com/mayank040902/framework/issues"
  },
  "homepage": "https://github.com/mayank040902/framework/tree/main/packages/redis#readme",
  "dependencies": {
    "bullmq": "^5.80.9",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  }
}
