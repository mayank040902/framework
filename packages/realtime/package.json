{
  "name": "@bootstrap-framework/realtime",
  "version": "1.0.0",
  "description": "Real-time WebSocket communication for Fastify and native WebSocket servers. Supports channels, pub/sub, E2EE encryption, and Kafka bridging.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "import": "./dist/hub.js",
      "default": "./dist/hub.js"
    },
    "./kafka-bridge": {
      "types": "./dist/kafka-bridge.d.ts",
      "import": "./dist/kafka-bridge.js",
      "default": "./dist/kafka-bridge.js"
    },
    "./e2ee": {
      "types": "./dist/e2ee.d.ts",
      "import": "./dist/e2ee.js",
      "default": "./dist/e2ee.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "example:fastify": "tsx examples/fastify-websocket.ts",
    "example:ws": "tsx examples/native-ws.ts",
    "example:e2ee": "tsx examples/e2ee.ts",
    "example:kafka-bridge": "tsx examples/kafka-bridge.ts",
    "example:secure-chat": "tsx examples/secure-chat-server.ts",
    "example:client": "node examples/client.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "realtime",
    "websocket",
    "fastify",
    "websockets",
    "pubsub",
    "channels",
    "e2ee",
    "encryption",
    "kafka",
    "bridge",
    "nodejs",
    "microservice",
    "bootstrap-framework"
  ],
  "author": "mayank",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank040902/framework.git",
    "directory": "packages/realtime"
  },
  "bugs": {
    "url": "https://github.com/mayank040902/framework/issues"
  },
  "homepage": "https://github.com/mayank040902/framework/tree/main/packages/realtime#readme",
  "dependencies": {
    "libsodium-wrappers": "^0.8.4",
    "notepack.io": "^3.0.1"
  },
  "devDependencies": {
    "@bootstrap-framework/kafka": "workspace:*",
    "@fastify/websocket": "^11.3.1",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.22.0",
    "fastify": "^5.12.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^2.0.0",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@bootstrap-framework/kafka": "^1.0.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@fastify/websocket": {
      "optional": true
    },
    "@bootstrap-framework/kafka": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
