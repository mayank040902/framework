{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "../../dist/examples",
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": false,
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "baseUrl": ".",
        "paths": {
            "@bootstrap-framework/logger": ["../../dist/index.d.ts"]
        }
    },
    "include": ["*.ts"]
}