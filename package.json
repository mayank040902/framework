{
  "name": "bootstrap-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js framework packages published independently as @bootstrap-framework/*",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "pack:check": "pnpm -r --filter \"./packages/*\" pack --dry-run",
    "publish:packages": "pnpm -r --filter \"./packages/*\" publish --access public",
    "example:combined": "pnpm --filter @bootstrap-framework/combined-example start"
  },
  "keywords": [
    "bootstrap",
    "framework",
    "node",
    "typescript"
  ],
  "author": "mayank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank040902/framework.git"
  },
  "bugs": {
    "url": "https://github.com/mayank040902/framework/issues"
  },
  "homepage": "https://github.com/mayank040902/framework#readme",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.9.0"
}
