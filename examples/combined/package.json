{
  "name": "@bootstrap-framework/combined-example",
  "version": "1.0.0",
  "private": true,
  "description": "Example Fastify service that combines every @bootstrap-framework package.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bootstrap-framework/auth": "workspace:*",
    "@bootstrap-framework/database": "workspace:*",
    "@bootstrap-framework/errors": "workspace:*",
    "@bootstrap-framework/kafka": "workspace:*",
    "@bootstrap-framework/logger": "workspace:*",
    "@bootstrap-framework/realtime": "workspace:*",
    "@bootstrap-framework/redis": "workspace:*",
    "@bootstrap-framework/server": "workspace:*",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
